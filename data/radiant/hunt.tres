[gd_resource type="Resource" script_class="RadiantTemplate" format=3]

[ext_resource type="Script" path="res://scripts/quests/radiant_template.gd" id="1_t"]

[resource]
script = ExtResource("1_t")
type = "hunt"
names = PackedStringArray("The Hunt for {chief}", "Beast: {chief}", "Kill {chief}")
