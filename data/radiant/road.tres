[ext_resource type="Script" path="res://scripts/quests/radiant_template.gd" id="1_t"]

[resource]
script = ExtResource("1_t")
type = "road"
names = PackedStringArray("Highwaymen on the Road", "The {destination} Road", "Clear the Road")
