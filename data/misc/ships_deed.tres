[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/items/item_data.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"ships_deed"
display_name = "Ship's Deed"
description = "Papers for a sailing ship of your own. Use it (E in the inventory) at the water's edge to launch her. Sail between the islands yourself, but mind the storms and what lives in the deep. Keep the deed: it calls her back to you."
item_type = 9
weight = 0.1
value = 8000
