; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="ELDERSCROLLSCLONE"
run/main_scene="res://scenes/game/main_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

_mcp_game_helper="*res://addons/godot_ai/runtime/game_helper.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/godot_ai/plugin.cfg")

[gui]

theme/custom="res://ui/ui_theme.tres"

[input]

interact={
"deadzone": 0.2,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":69,"key_label":0,"unicode":101,"location":0,"echo":false,"script":null)
]
}

[layer_names]

3d_render/layer_3="Interactable"
3d_physics/layer_1="World"
3d_physics/layer_3="Interactable"
3d_physics/layer_5="Enemies"
3d_physics/layer_6="Items"

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
occlusion_culling/use_occlusion_culling=true

[shader_globals]

mw_surfaces={
"type": "bool",
"value": false
}
mw_grass={
"type": "sampler2D",
"value": ""
}
mw_earth={
"type": "sampler2D",
"value": ""
}
mw_rock={
"type": "sampler2D",
"value": ""
}
mw_stone={
"type": "sampler2D",
"value": ""
}
mw_wood={
"type": "sampler2D",
"value": ""
}
mw_plaster={
"type": "sampler2D",
"value": ""
}
