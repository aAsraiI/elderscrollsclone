class_name QuestDefsSettlements
extends RefCounted
## The settlement quests of the design bible (S-...): the questlines of the nine great towns,
## and the quests of every town and village. See QD for the builders and QuestBook for how they run.

const I := "res://scripts/Resources/Ingredients/"
const W := "res://scripts/Resources/Weapons/"
const A := "res://scripts/Resources/Armor/"
const J := "res://scripts/Resources/Jewelry/"
const C := "res://scripts/Resources/Clothing/"
const R := "res://scripts/Resources/Ranged/"
const P := "res://scripts/Resources/Consumables/"


static func list() -> Array:
	var out: Array = []
	out.append_array(_plains())
	out.append_array(_lakeland())
	out.append_array(_coast())
	out.append_array(_forest())
	out.append_array(_swamp())
	out.append_array(_desert())
	out.append_array(_highlands())
	out.append_array(_north())
	out.append_array(_ashlands())
	out.append_array(_villages_two())
	return out


# ---------------------------------------------------------------- Plains

static func _plains() -> Array:
	var ames := QD.cast("Watch Captain Bertil Ames", "Kingsreach")
	var priest := QD.cast("Father Anselm of the Dawn", "Kingsreach", "temple")
	var chancellor := QD.cast("Lord Chancellor Edric Haverly", "Kingsreach")
	var rhosyn := QD.cast("Sunguard Captain Rhosyn Vale", "Kingsreach")
	var mage := QD.cast("Court Mage Ilsabet Corrow", "Kingsreach", "guild:mages")
	var king := QD.lord("Kingsreach")
	return [
		QD.q("S-KR01", "False Crowns", "Kingsreach", ames, 2, "false crowns",
			"Fake gold crowns are everywhere and the merchants won't take real ones. Find who mints them. My guess: the old cisterns under the city.",
			[QD.fight(QD.dun("Kingsreach"), [QD.f("bandit", 3), QD.f("bandit_thug", 1, "Master Forger Dace")], "Find the counterfeiters' den below Kingsreach and stop the forger."),
			QD.choice(ames, "Report to Captain Ames.", [QD.opt("arrest the forger", "Good. He'll hang, and the market can breathe again.", "arrested"), QD.opt("take a cut", "...I didn't hear that. Here's your pay. Keep your mouth shut.", "cut")])],
			QD.reward(300)),
		QD.q("S-KR02", "The Bell That Rang at Midnight", "Kingsreach", priest, 4, "the midnight bell",
			"Every night at midnight our bell rings by itself. A ghost, I think, from the Sundering. Its bones lie somewhere in the catacombs.",
			[QD.fetch(QD.dun("Kingsreach", 1), "Bell-Ringer's Bones", "Find the bell-ringer's bones in the catacombs near Kingsreach."),
			QD.talk(priest, "the bell-ringer's bones", "Rest now, old friend... Did you hear it? 'The sun-crown sickens from within.' The King. Gods keep him.", "Bring the bones to Father Anselm for rites.")],
			QD.reward(200, {"perk": {"resist_fire": 0.05}, "items": [J + "silver_amulet_vigor.tres"]})),
		QD.q("S-KR03", "Petitions at Court", "Kingsreach", chancellor, 5, "petitions at court",
			"The King is too ill to hear petitions. You have an honest face. Hear three for him.",
			[QD.choice(chancellor, "Rule on the widow's stolen field.", [QD.opt("give the widow her field", "Justice, then. The widow keeps her field.", "widow"), QD.opt("side with the lord", "The lord keeps the field. The widow weeps.", "lord")]),
			QD.collect(P + "bread.tres", 3, "The guild dispute: bring three loaves to settle the bakers' wager."),
			QD.talk(chancellor, "the lost noble", "A lost noble? His seal was a forgery. Well judged. The King will hear of you: Friend of the Crown.", "Report the bakers settled and hear the last petition.")],
			QD.reward(250, {"title": "Friend of the Crown"})),
		QD.q("S-KR04", "The Princess Goes Missing", "Kingsreach", rhosyn, 7, "the missing princess",
			"The princess has slipped out of the castle again. Find her before someone else does.",
			[QD.visit(QD.wild("Kingsreach", 220.0, 40.0), "Find Princess Elowen in the Lower Ward, by the old graves."),
			QD.fight(QD.wild("Kingsreach", 220.0, 40.0), [QD.f("cutthroat", 3, "")], "Hired knives were waiting for her. Protect the princess."),
			QD.talk(rhosyn, "the princess is safe", "You found her, and you kept her alive. She asked your name. Take this: she wanted you to have it.", "Bring word to Captain Vale.")],
			QD.reward(300, {"named": [QD.named("Elowen's Ribbon", J + "silver_ring_wind.tres", [["fortify_speech", 8]])]}),
			QD.req(["S-KR03"])),
		QD.q("S-KR05", "The Late Prince's Journal", "Kingsreach", chancellor, 9, "the prince's journal",
			"Prince Caedric's journal. Six pages torn out. Find them, and we may learn how he truly died.",
			[QD.fetch(QD.dun("Kingsreach", 2), "Torn Journal Pages", "Search for the torn pages; the trail leads to a den outside the city."),
			QD.talk(chancellor, "the torn pages", "Briarwatch... he met someone at Briarwatch the night he died. Go there.", "Bring the pages to the Chancellor.")],
			QD.reward(500), QD.req(["S-KR04"])),
		QD.q("S-KR06", "Into the Old Keep", "Kingsreach", mage, 11, "the old keep",
			"The King's sickness is magic, I'm sure of it. Beneath Castle Dawnhold lies the Old Keep, and the Vault of Aurel.",
			[QD.clear(QD.dun("Kingsreach", 3), "Fight down through the Old Keep beneath Kingsreach to the Vault of Aurel."),
			QD.talk(mage, "the vault of aurel", "Nightglass. A vampire's poison. The reliquary is yours; you earned it.", "Tell the Court Mage what the vault held.")],
			QD.reward(600, {"named": [QD.named("Reliquary of Aurel", J + "gold_amulet_vigor.tres", [["fortify_health", 25], ["regenerate_health", 6]])]}), QD.req(["S-KR05"])),
		QD.q("S-KR07", "The Poisoner's Table", "Kingsreach", chancellor, 12, "the poisoner",
			"At the Feast of Seedfall every house sends an envoy. One of them is feeding our King Nightglass. Find out who.",
			[QD.talk(QD.cast("Royal Taster Pell", "Kingsreach", "inn"), "the taster's ledger", "The ledger... payments from a Morvaine steward, in Nightglass. Gods forgive me.", "Question the royal taster at the inn."),
			QD.choice(chancellor, "Name the poisoner to the Chancellor.", [QD.opt("accuse house morvaine", "The truth, then. Morvaine will answer for it.", "morvaine"), QD.opt("accuse a rival house", "...If you say so. It will be done.", "framed")])],
			QD.reward(1000, {"items": [C + "noble_garb.tres"], "title": "Sworn of the Crown"}), QD.req(["S-KR06"])),
		QD.q("S-KR08", "Long Live the King", "Kingsreach", king, 14, "the king's last request",
			"I need one more year to set my realm in order. Guard me tonight. They will come.",
			[QD.fight(QD.town("Kingsreach"), [QD.f("vampire", 1, "Velvet Court Assassin"), QD.f("cutthroat", 2)], "Defend the King's solar from the Velvet Court assassin."),
			QD.choice(king, "Speak with the King.", [QD.opt("give him the cure", "I feel... stronger. A year. Thank you.", "saved"), QD.opt("let him rest", "Then I will sign my will tonight, and sleep.", "peace")])],
			QD.reward(1500, {"named": [QD.named("The King's Signet", J + "gold_ring_insight.tres", [["fortify_speech", 12], ["fortify_charisma", 5]])], "home": "Kingsreach"}), QD.req(["S-KR07"])),
		QD.q("S-HF01", "The Horse Fair Thief", "Harrowford", QD.lord("Harrowford"), 3, "the horse thieves",
			"Prize horses vanish from my fair, and my own black mare Duchess with them. Bandits, in the old fort.",
			[QD.fight(QD.camp("Harrowford"), [QD.f("bandit", 3), QD.f("bandit_brute", 1, "Horse-Thief Gannet")], "Raid the horse thieves' camp near Harrowford."),
			QD.talk(QD.lord("Harrowford"), "duchess is found", "My Duchess! Take this deed: any horse of mine, at half price.", "Return to Baron Fenn.")],
			QD.reward(300, {"items": ["res://scripts/Resources/Misc/horse_deed.tres"]})),
		QD.q("S-HF02", "The Toll at the Ford", "Harrowford", QD.cast("Merchant Aldwin Kettle", "Harrowford", "inn"), 5, "the ford toll",
			"Men in the Baron's colours charge a toll at the ford. The Baron swears they are not his.",
			[QD.fight(QD.wild("Harrowford", 260.0, 180.0), [QD.f("deserter", 3), QD.f("deserter_captain", 1, "Edric Fenn")], "Deal with the deserters at the ford, led by the Baron's disgraced son."),
			QD.talk(QD.lord("Harrowford"), "your son", "So it was Edric. I should have known. You have my thanks, and my bounty is forgiven.", "Tell Baron Fenn the truth.")],
			QD.reward(400)),
		QD.q("S-WH01", "The Scarecrow That Walks", "Wheatley", QD.lord("Wheatley"), 1, "the walking scarecrow",
			"A scarecrow walks our fields at night. The crows won't touch the grain. A hedge-witch lives out by the old mill.",
			[QD.talk(QD.spawn(QD.wild("Wheatley", 300.0, 90.0), "Hedge-Witch Morwen", "pilgrim"), "the scarecrow", "I bound the farmer's dead boy into it to guard the harvest. It was a kindness!", "Find the hedge-witch's hut."),
			QD.choice(QD.lord("Wheatley"), "Tell the reeve.", [QD.opt("free the boy's soul", "Then he can rest. Thank you.", "freed"), QD.opt("let him keep guard", "Then the fields stay safe. So be it.", "guard")])],
			QD.reward(150)),
		QD.q("S-OR01", "Rot in the Great Oak", "Oakrest", QD.lord("Oakrest"), 3, "the dying oak",
			"Maela's great oak is dying. Something eats at its roots, in the cave below.",
			[QD.collect(I + "lavender.tres", 3, "Gather three lavender to cleanse the roots."),
			QD.talk(QD.lord("Oakrest"), "the lavender", "Good. Now the root cave. Kill what feeds on our oak.", "Bring the lavender to the reeve."),
			QD.fight(QD.wild("Oakrest", 120.0, 0.0), [QD.f("deep_crawler", 2), QD.f("crawler_queen", 1, "The Grub-Mother")], "Kill the grub-mother under the great oak.")],
			QD.reward(200, {"perk": {"max_health": 5.0}})),
		QD.q("S-BC01", "The Inn of Four Roads", "Brindle Cross", QD.cast("Traveller's Sister Hedda", "Brindle Cross"), 4, "the vanished travellers",
			"My brother took a room at the Four Roads Inn and never came out. Others too.",
			[QD.fight(QD.wild("Brindle Cross", 90.0, 270.0), [QD.f("barrow_wight", 1, "The Buried Wight"), QD.f("bandit", 2)], "Find the cellar beneath the inn, and what the innkeepers feed."),
			QD.talk(QD.cast("Traveller's Sister Hedda", "Brindle Cross"), "my brother", "Then he is gone. But no one else will be. Take what was theirs; they owe you.", "Tell Hedda.")],
			QD.reward(450)),
	]


# ---------------------------------------------------------------- Lakeland

static func _lakeland() -> Array:
	var ottilie := QD.cast("Bridgewarden Ottilie Brask", "Merewater")
	var fenwick := QD.cast("Alchemist Fenwick Merrow", "Merewater", "shop")
	var dagny := QD.cast("Fisherwoman Dagny Reeve", "Merewater")
	var herald := QD.cast("Regatta Herald Pim", "Merewater", "inn")
	var aveline := QD.cast("Lady Aveline Valcourt", "Merewater")
	var duke := QD.lord("Merewater")
	return [
		QD.q("S-MW01", "The Bridgewarden's Winch", "Merewater", ottilie, 4, "the jammed bridges",
			"Someone cuts the winch chains of my lift-bridges. The Bargemen profit when people must hire boats.",
			[QD.fight(QD.camp("Merewater"), [QD.f("smuggler", 3), QD.f("smuggler_chief", 1, "Bargemaster Rook")], "Break the Bargemen gang."),
			QD.talk(ottilie, "the bargemen", "The bridges run again! Ride my boats free, any time.", "Report to the Bridgewarden.")],
			QD.reward(300)),
		QD.q("S-MW02", "Eels in the Cistern", "Merewater", fenwick, 5, "the bloody water",
			"The water tastes of blood. An apprentice fed growth potions to the cistern eels...",
			[QD.fight(QD.dun("Merewater"), [QD.f("deep_crawler", 3, ""), QD.f("crawler_queen", 1, "The Giant Eel")], "Clear the flooded cistern and its giant eels."),
			QD.talk(fenwick, "the apprentice", "Alive! Foolish boy. Here: eel-skin boots, and the growth draught recipe.", "Return to Fenwick.")],
			QD.reward(250, {"named": [QD.named("Eel-Skin Boots", A + "leather_boots.tres", [["haste", 6]])]})),
		QD.q("S-MW03", "Lights Under the Lake", "Merewater", dagny, 6, "the lights under the lake",
			"Green lights, deep under the lake. An old elven causeway hall, people say.",
			[QD.fetch(QD.dun("Merewater", 1), "Star-Glass Lantern", "Find the star-glass lantern in the sunken causeway hall."),
			QD.talk(dagny, "the star-glass lantern", "Still burning after all these years... keep it. It shows what hides.", "Show Dagny the lantern.")],
			QD.reward(200, {"named": [QD.named("Lantern of the Mere", J + "silver_amulet_insight.tres", [["night_eye", 1]])]})),
		QD.q("S-MW04", "The Regatta", "Merewater", herald, 7, "the regatta",
			"The Duke's regatta! Race the canals to the lake markers. And beware: someone sabotages boats.",
			[QD.visit(QD.wild("Merewater", 300.0, 30.0), "Reach the first lake marker.", 30.0),
			QD.visit(QD.wild("Merewater", 420.0, 100.0), "Reach the far lake marker.", 30.0),
			QD.fight(QD.wild("Merewater", 300.0, 160.0), [QD.f("smuggler", 2, "Saboteur Wim")], "Catch the saboteur at the last marker."),
			QD.talk(herald, "the regatta win", "The Silver Oar is yours! The Duke himself will hear of it.", "Return to the herald.")],
			QD.reward(500)),
		QD.q("S-MW05", "The Heron's Daughter", "Merewater", aveline, 8, "a secret letter",
			"I am promised to the Brannoch heir, but my heart is in Reedholm, with a boatwright. Will you carry a letter?",
			[QD.talk(QD.cast("Boatwright Corwin Ashe", "Reedholm"), "aveline's letter", "She wrote... she means it? Then tell her I'll wait at the jetty.", "Carry Aveline's letter to Corwin in Reedholm.", {"carry": "Aveline's Letter"}),
			QD.choice(aveline, "Return to Lady Aveline.", [QD.opt("help her elope", "Tonight, then. Thank you!", "eloped"), QD.opt("urge the marriage", "...Duty. Yes. You are right, I suppose.", "married"), QD.opt("tell the duke", "You... You told my father?", "told")])],
			QD.reward(300)),
		QD.q("S-MW06", "The Fog Comes Early", "Merewater", duke, 10, "the fog",
			"Fog has fallen on my city and wraiths walk the bridges. It rises from beneath Castle Stillmere.",
			[QD.fight(QD.town("Merewater"), [QD.f("ice_wraith", 4), QD.f("vampire", 1, "Velvet Court Fog-Keeper")], "Fight through the fog-wraiths to the elven pump-hall beneath the castle."),
			QD.talk(duke, "the fog-engine", "A Velvet Court agent switched it on to feed unseen. Take Wraithbane. There is more to do.", "Report to the Duke.")],
			QD.reward(600, {"named": [QD.named("Wraithbane", W + "silver_spear.tres", [["frost_damage", 10]])]}), QD.req(["S-MW03"])),
		QD.q("S-MW07", "Causeway of the Elders", "Merewater", duke, 13, "the fog crystal",
			"The fog-engine needs its Fog Crystal to be controlled. It lies in a ruined sky-tower out on the lake.",
			[QD.fetch(QD.dun("Merewater", 2), "Fog Crystal", "Climb the ruined sky-tower and take the Fog Crystal from its warden."),
			QD.choice(duke, "Who should have the crystal?", [QD.opt("give it to the duke", "Merewater can hide itself in war. Valcourt thanks you.", "duke"), QD.opt("give it to the mages guild", "...The Guild, then. Very well.", "mages")])],
			QD.reward(1200, {"home": "Merewater"}), QD.req(["S-MW06"])),
		QD.q("S-RH01", "Reed Fire", "Reedholm", QD.lord("Reedholm"), 6, "the reed fires",
			"Someone burns the reed beds every night, signalling across the lake.",
			[QD.fight(QD.camp("Reedholm"), [QD.f("ash_cultist", 3), QD.f("ashen_priest", 1, "Signal-Keeper Vos")], "Wipe out the Ash Cult cell in the flooded watchtower."),
			QD.talk(QD.lord("Reedholm"), "the ash cult letters", "Coded letters... the Ash Cult. The priests of the Dawn should see these.", "Report to Baroness Marrow.")],
			QD.reward(400)),
		QD.q("S-RH02", "The Boatwright's Debt", "Reedholm", QD.cast("Boatwright Corwin Ashe", "Reedholm"), 7, "the loan shark",
			"A Tidewell loan shark will take my yard. The loan was forged, I swear it.",
			[QD.fetch(QD.camp("Reedholm", 1), "The Forged Loan", "Find the loan shark's papers in his hideout."),
			QD.talk(QD.cast("Boatwright Corwin Ashe", "Reedholm"), "the forged loan", "Forged, as I said! A boat for you: free passage across the lakes.", "Bring Corwin the papers.")],
			QD.reward(350)),
		QD.q("S-SW01", "The Drowned Church", "Stillwater", QD.lord("Stillwater"), 5, "the drowned church",
			"Our villagers sleepwalk into the lake when the drowned church's bell rings.",
			[QD.clear(QD.dun("Stillwater"), "Go down to the drowned church and break the cursed font."),
			QD.talk(QD.lord("Stillwater"), "the font is broken", "They sleep sound tonight. Stay with us whenever you pass.", "Tell the reeve.")],
			QD.reward(250, {"named": [QD.named("Font Stone", J + "copper_amulet_endurance.tres", [["resist_frost", 15]])]})),
		QD.q("S-HW01", "The Lighthouse That Warns of Nothing", "Heron's Wick", QD.lord("Heron's Wick"), 7, "the ghost ship",
			"Every new moon I see a ship and light the warning fire. There is never a ship.",
			[QD.fight(QD.wild("Heron's Wick", 250.0, 0.0), [QD.f("skeleton", 3), QD.f("skeleton_knight", 1, "The Ghost Captain")], "Row out at midnight and board the ghost galley."),
			QD.talk(QD.lord("Heron's Wick"), "the ghost captain", "The ship is gone for good. Take his cutlass; no one else wants it.", "Return to the keeper.")],
			QD.reward(250, {"named": [QD.named("Ghost Captain's Cutlass", W + "steel_sword.tres", [["frost_damage", 9]])]})),
	]


# ---------------------------------------------------------------- Coast

static func _coast() -> Array:
	var mother := QD.cast("Widow Alys Moor", "Saltmere", "inn")
	var kell := QD.cast("Customs Master Aubrey Kell", "Saltmere")
	var crane := QD.cast("Harbourmaster Jenna Crane", "Saltmere")
	var rook := QD.cast("Admiral Cassia Rook", "Saltmere")
	var duchess := QD.lord("Saltmere")
	return [
		QD.q("S-SM01", "Press-Ganged", "Saltmere", mother, 10, "my son was taken",
			"The press gangs took my boy by mistake! He's on the prison hulk. The fleet sails at dawn.",
			[QD.fight(QD.camp("Saltmere"), [QD.f("raider", 3), QD.f("raider_marauder", 1, "Press-Master Hogg")], "Get aboard the prison hulk and free the merchant's son."),
			QD.talk(mother, "your son is free", "My boy! Bless you. My husband's shop will give you a fair price, always.", "Bring word to his mother.")],
			QD.reward(350)),
		QD.q("S-SM02", "The Customs House Ledger", "Saltmere", kell, 11, "the burned ledger",
			"The customs ledger didn't burn. It's in a warehouse vault, and it shows who splits the smuggling profits.",
			[QD.fetch(QD.dun("Saltmere"), "Customs Ledger", "Find the customs ledger in the warehouse vault."),
			QD.choice(kell, "Who gets the ledger?", [QD.opt("give it to the duchess", "The Duchess will clean house. Quietly.", "duchess"), QD.opt("give it to the consortium", "The Consortium pays well for silence.", "consortium"), QD.opt("give it to the crown", "The Crown will remember this.", "crown")])],
			QD.reward(500)),
		QD.q("S-SM03", "Wreckers' Lights", "Saltmere", crane, 12, "the false beacons",
			"Ships run aground on the Teeth after following false beacons. Find the wreckers.",
			[QD.fight(QD.camp("Saltmere", 1), [QD.f("smuggler", 3), QD.f("smuggler_chief", 1, "Wrecker Queen Tilda")], "Find the wreckers' cave and end them."),
			QD.talk(crane, "the wreckers", "No more false lights. Take a share of what they took.", "Report to the Harbourmaster.")],
			QD.reward(600)),
		QD.q("S-SM04", "The Missing Treasure Ship", "Saltmere", duchess, 14, "the dawn's tithe",
			"The Dawn's Tithe, carrying the realm's tax silver, is gone. Pirates, I am sure.",
			[QD.fetch(QD.dun("Saltmere", 1), "Tax Silver Chest", "Find the sea cave where pirates break up the Dawn's Tithe."),
			QD.talk(duchess, "the tax silver", "The silver is saved. And this chart... Port Wrack, in the Shattered Isles.", "Return the silver to the Duchess.")],
			QD.reward(800), QD.req(["S-SM03"])),
		QD.q("S-SM05", "The Admiralty Ball", "Saltmere", QD.cast("Lord Treasurer Benedek Tidewell", "Saltmere"), 15, "the masked ball",
			"A pirate spy is among my guests tonight. Unmask them before midnight.",
			[QD.choice(QD.cast("Lord Treasurer Benedek Tidewell", "Saltmere"), "Name the spy.", [QD.opt("the quartermaster's wife", "...Clever. She had the code book on her.", "found")]),
			QD.fight(QD.wild("Saltmere", 120.0, 0.0), [QD.f("cutthroat", 1, "Drunk Lord Mallory")], "A drunk noble challenges you. Win the duel.")],
			QD.reward(300, {"items": [C + "fine_tunic.tres"]}), QD.req(["S-SM04"])),
		QD.q("S-SM06", "Black Sails Over Saltmere", "Saltmere", rook, 18, "the black sails",
			"Three pirate ships are in the harbour! Hold the docks!",
			[QD.fight(QD.town("Saltmere"), [QD.f("raider", 4), QD.f("raider_marauder", 2)], "Hold the docks against the pirate raid."),
			QD.fight(QD.wild("Saltmere", 220.0, 270.0), [QD.f("smuggler_chief", 1, "Captain of the Red Gull"), QD.f("cutthroat", 2)], "Board the flagship and kill its captain."),
			QD.talk(rook, "the drowned king wakes", "'The Drowned King wakes.' His last words? Then we sail for the Isles.", "Report to Admiral Rook.")],
			QD.reward(800, {"named": [QD.named("Boarding Axe of the Red Gull", W + "steel_waraxe.tres", [["shock_damage", 10]])], "title": "Defender of Saltmere"}), QD.req(["S-SM05"])),
		QD.q("S-SM07", "Beyond the Breakers", "Saltmere", rook, 22, "the shattered isles",
			"We sail for the Shattered Isles. Board my ship at the docks and bring down Saltbones.",
			[QD.realm("R1", "Sail to the Shattered Isles and take the Tidecrown, Saltbones' stronghold."),
			QD.talk(rook, "saltbones is dead", "The Isles are open to honest ships at last. Keep her tricorn, Captain.", "Return to Admiral Rook.")],
			QD.reward(1500, {"named": [QD.named("Saltbones Tricorn", A + "leather_helmet.tres", [["fortify_sneak", 12], ["fortify_speech", 8]])]}), QD.req(["S-SM06"])),
		QD.q("S-GH01", "The Smugglers' Stair", "Gullhaven", QD.lord("Gullhaven"), 12, "the smugglers' tunnel",
			"A tunnel runs from the cliffs into my town. Find it, and seal it.",
			[QD.clear(QD.dun("Gullhaven"), "Find the smugglers' tunnel under the cliffs."),
			QD.choice(QD.lord("Gullhaven"), "Report to Baron Pike.", [QD.opt("seal the tunnel", "Sealed. Good work.", "sealed"), QD.opt("keep their secret", "Nothing there? ...If you say so.", "smugglers")])],
			QD.reward(400)),
		QD.q("S-GH02", "The Cliff Divers", "Gullhaven", QD.cast("Champion Diver Petra Gull", "Gullhaven"), 13, "the diving contest",
			"Grab the tokens from the sea floor. The last is in the crab's cave.",
