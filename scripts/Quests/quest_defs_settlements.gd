# ---------------------------------------------------------------- the second quest of every village

# A village's second quest: given by its reeve (or knight), after its first
static func _v2(id: String, name: String, town: String, level: int, hook: String, intro: String, steps: Array, reward: Dictionary, first: String) -> Dictionary:
	return QD.q(id, name, town, QD.lord(town), level, hook, intro, steps, reward, QD.req([first]))


