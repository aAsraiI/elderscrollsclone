class_name QuestDefsRealms
extends RefCounted
## The side quests of the instanced realms (R-..): given by the people of each realm's hub, about
## its sites (see RealmManager.REALMS for the sites and people of each realm).

const W := "res://data/weapons/"
const A := "res://data/armor/"
const J := "res://data/jewelry/"


static func _r(id: String, name: String, realm: String, npc: String, level: int, hook: String, intro: String, steps: Array, reward: Dictionary, extra: Dictionary = {}) -> Dictionary:
	return QD.q(id, name, RealmManager.display_name(realm), QD.realm_npc(realm, npc), level, hook, intro, steps, reward, extra)


static func list() -> Array:
	var maura := QD.realm_npc("R1", "Shipwright Odo")
	return [
		_r("R-SI01", "The Tide Temple", "R1", "Shipwright Odo", 25, "the tide temple",
			"The Tide Temple on Wreck Isle opens only at low tide. The Pearl Crown is inside.",
			[QD.site("R1", 3, "Clear the Tide Temple before the water returns."),
			QD.talk(maura, "the pearl crown", "The sea-elves' crown! Wear it well.", "Show Odo what you found.")],
			QD.reward(800, {"named": [QD.named("Pearl Crown of the Sea-Elves", A + "silver_helmet.tres", [["resist_frost", 15], ["fortify_magicka", 20]])]})),
		_r("R-SI02", "The Pirate Council", "R1", "Port Wrack Fence", 28, "the pirate council",
			"With Saltbones gone, Port Wrack's captains need a lord. Win them, or take the seat.",
			[QD.site("R1", 2, "Win the favour of the Saltbone Atoll captains by clearing their rivals."),
			QD.site("R1", 0, "Clear the Gull Rock smugglers who defy the council."),
			QD.choice(QD.realm_npc("R1", "Port Wrack Fence"), "Who leads Port Wrack?", [QD.opt("i take the seat", "Lord of Port Wrack! Ha! Your hall is ready.", "lord"), QD.opt("captain vey's mate", "A fair choice. The Isles stay quiet.", "mate")])],
			QD.reward(1500, {"title": "Lord of Port Wrack"}), QD.req(["S-SM07"])),
		_r("R-SI03", "The Ondrel Tower", "R1", "Shipwright Odo", 32, "the ondrel tower",
			"The Mages Guild lost a tower on the Isle of Ondrel sixty years ago.",
			[QD.site("R1", 1, "Climb the Tower of Ondrel and free its last mage's ghost."),
			QD.talk(QD.realm_npc("R1", "Shipwright Odo"), "the storm staff", "The storm-calling staff! The Guild will want to know.", "Bring news to Odo.")],
			QD.reward(900, {"named": [QD.named("Storm-Caller of Ondrel", W + "silver_spear.tres", [["shock_damage", 16]])]})),
		_r("R-TD01", "The Dreamer Who Will Not Wake", "R2", "A Sleeping Woodborn Child", 20, "the sleeping child",
			"(She speaks in her sleep.) The fears... the fears in the dark dream hold me...",
			[QD.site("R2", 1, "Break the first fear, in the Hollow Moon Tree."),
			QD.site("R2", 2, "Break the second fear, in the Weeping Barrow."),
			QD.talk(QD.realm_npc("R2", "A Sleeping Woodborn Child"), "wake up", "...I'm awake? I'm awake! Take me home!", "Wake the child.")],
			QD.reward(600, {"perk": {"stealth": 3.0}})),
		_r("R-TD02", "The Talking Fox's Wager", "R2", "The Talking Fox", 22, "the fox's wager",
			"Three riddles for my golden tail, mortal. What walks without legs?",
			[QD.choice(QD.realm_npc("R2", "The Talking Fox"), "Answer the fox.", [QD.opt("a river", "Correct! Next: what has roots none see? ...a mountain! You win, curse you.", "won")])],
			QD.reward(0, {"named": [QD.named("Fox-Tail Ring", J + "silver_ring_wind.tres", [["fortify_sneak", 15]])]})),
		_r("R-KA01", "The Legion That Never Fell", "R3", "Expedition Leader Ysolde Dask", 34, "the ghost legion",
			"A ghost legion guards the barracks, waiting for orders.",
			[QD.site("R3", 1, "Find the emperor's seal in the Legion Barracks and command them to stand down."),
			QD.talk(QD.realm_npc("R3", "Expedition Leader Ysolde Dask"), "the legion", "Stood down after four hundred years. Their legate's blade is yours.", "Report to Ysolde.")],
			QD.reward(1200, {"named": [QD.named("Legate's Gladius", W + "starforged_sword.tres", [["fortify_attack", 10]])]})),
		_r("R-KA02", "The Emperor's Bath", "R3", "Digger Omar", 30, "the golden duck",
			"The emperor's gold bath-duck! A famous relic, guarded by giant crabs.",
			[QD.site("R3", 3, "Retrieve the golden duck from the Emperor's Bath."),
			QD.talk(QD.realm_npc("R3", "Digger Omar"), "the golden duck", "The Golden Duck of Aurel! Priceless. Utterly priceless.", "Show Omar.")],
			QD.reward(1500, {"items": ["res://data/treasure/carved_idol.tres"]})),
		_r("R-BD01", "A Letter to the Living", "R4", "The Dead Mother", 36, "a letter to the living",
			"Carry my words to my great-grandson in Stonebrook, and bring his answer.",
			[QD.talk(QD.lord("Stonebrook"), "the dead mother's letter", "From... her? Tell her I named my daughter after her.", "Carry the letter to Stonebrook.", {"carry": "Letter from the Dead"}),
			QD.talk(QD.realm_npc("R4", "The Dead Mother"), "his answer", "He named her after me... I can rest gladly now.", "Bring the answer back.")],
			QD.reward(500, {"perk": {"resist_frost": 0.1}})),
		_r("R-BD02", "The Bone Mines", "R4", "Cairn-Under Bone-Merchant", 40, "the bone mines",
			"The deepest seam woke something that eats souls.",
			[QD.site("R4", 0, "Kill the soul-eater in the Bone Mines."),
			QD.talk(QD.realm_npc("R4", "Cairn-Under Bone-Merchant"), "the soul-eater", "The Stone King will hear your name kindly.", "Report to the bone-merchant.")],
			QD.reward(1200)),
		_r("R-GL01", "The Ferryman's Fee", "R5", "Old Weir the Ferryman", 30, "the ferryman's fee",
			"A soul for the passage. Find one that wants to move on: a knight of the Red Winter.",
			[QD.site("R5", 3, "Free the Red Winter knight from the Prison of Souls."),
			QD.talk(QD.realm_npc("R5", "Old Weir the Ferryman"), "the knight's soul", "A fair fee. Ride with me any time.", "Return to Old Weir.")],
			QD.reward(500)),
		_r("R-GL02", "The Prison of Souls", "R5", "Old Weir the Ferryman", 40, "the prison of souls",
			"Thousands of souls are caged. Free them, and every clan hates you for a while.",
			[QD.site("R5", 0, "Break the Velvet Court's hold at the Drowned Sanctum."),
			QD.site("R5", 1, "Break the Hollow Kin's hold at the Bone-Fort."),
			QD.site("R5", 2, "Break the Choir's hold at the Black Chapel."),
			QD.talk(QD.realm_npc("R5", "Old Weir the Ferryman"), "the souls are free", "They go to Vey at last. Well done, living one.", "Return to Old Weir.")],
			QD.reward(2000, {"perk": {"max_magicka": 15.0}}), QD.req(["R-GL01"])),
		_r("R-HG01", "The Hunter Who Cannot Rest", "R6", "The Dead Lodge Master", 32, "the broken law",
			"I broke the law of the hunt once. The wolf I wronged waits in its den.",
			[QD.site("R6", 0, "Find the wronged wolf's den."),
			QD.talk(QD.realm_npc("R6", "The Dead Lodge Master"), "peace with the wolf", "Peace at last. I can feast with my brothers.", "Return to the Lodge Master.")],
			QD.reward(700)),
		_r("R-HG02", "The First Wolf", "R6", "Greyfang Ancestor", 40, "the first wolf",
			"The First Wolf sleeps. Wake her and ask: can the curse be a gift without the hunger?",
			[QD.site("R6", 1, "Win the Stag Lord's Ring."),
			QD.site("R6", 2, "Run the Thorn Maze."),
			QD.talk(QD.realm_npc("R6", "Greyfang Ancestor"), "the first wolf's answer", "Yes. If you choose the hunt, not the kill. Carry her blessing.", "Return to the ancestor.")],
			QD.reward(1000, {"perk": {"max_stamina": 20.0}})),
		_r("R-IW01", "The Frozen Fleet", "R7", "Frozen Captain Hakon", 56, "the frozen fleet",
			"Our fleet froze four hundred years ago. Thaw my crew and I'll show you the way.",
			[QD.site("R7", 0, "Free the Frozen Fleet's crew."),
			QD.talk(QD.realm_npc("R7", "Frozen Captain Hakon"), "the way to the hall", "Warm at last! The Hall of the Bear lies past the glacier.", "Return to Captain Hakon.")],
			QD.reward(1500)),
		_r("R-IW02", "The Exiles' Spring", "R7", "Exile Chief Ragnhild", 58, "the freezing spring",
			"The spring that keeps Thaw-Camp alive is freezing. A frost wyrm sits on its source.",
			[QD.site("R7", 1, "Kill the frost wyrm in the Glacier Heart."),
			QD.talk(QD.realm_npc("R7", "Exile Chief Ragnhild"), "the spring", "It runs warm! We live another winter.", "Return to Ragnhild.")],
			QD.reward(1500, {"perk": {"resist_frost": 0.15}})),
		_r("R-SG01", "The Last Gardeners", "R8", "Caretaker Aelindra", 58, "the last seeds",
			"We are dying. Gather seeds from three islands so the garden outlives us.",
			[QD.site("R8", 0, "Gather seeds at the Star Observatory."),
			QD.site("R8", 1, "Gather seeds at the Hanging Library."),
			QD.choice(QD.realm_npc("R8", "Caretaker Aelindra"), "Who gets the last elixir of youth?", [QD.opt("aelindra", "Then I will keep the garden.", "aelindra"), QD.opt("thessaly", "Thessaly will sing to it.", "thessaly"), QD.opt("orin", "Orin, then. He was always the patient one.", "orin")])],
			QD.reward(2000, {"named": [QD.named("Ilvaris Star-Robes", A + "starweave_cuirass.tres", [["fortify_magicka", 40], ["regenerate_magicka", 30]])]})),
		_r("R-SG02", "Bring Down the Sky", "R8", "Caretaker Orin", 68, "the engine spire",
			"A rogue construct means to crash Ilvaris onto Kingsreach!",
			[QD.site("R8", 2, "Stop the rogue construct in the Engine Spire."),
			QD.talk(QD.realm_npc("R8", "Caretaker Orin"), "the city is safe", "Ilvaris floats on, harmless. You saved two cities today.", "Return to Orin.")],
			QD.reward(3000)),
		_r("R-MC01", "Your Own Reflection", "R9", "Mirror-Merchant Lahsa", 30, "your reflection",
			"Your reflection stole your best weapon and ran into the towers!",
			[QD.site("R9", 0, "Chase your reflection through the First Reflected Tower."),
			QD.talk(QD.realm_npc("R9", "Mirror-Merchant Lahsa"), "my reflection", "Beat yourself! Ha. Take a reflected blade, on the house.", "Return to Lahsa.")],
			QD.reward(800, {"named": [QD.named("Reflected Blade", W + "silver_sword.tres", [["absorb_stamina", 10]])]})),
		_r("R-UE01", "The Eaten Kings", "R10", "Sister Lumen", 70, "the eaten kings",
			"Three eaten elven kings hold the keys to the Heart of the Black Sun.",
			[QD.site("R10", 0, "Defeat the shadow of the first king in Shadow Kingsreach."),
			QD.site("R10", 1, "Defeat the second in the Spire of Hunger."),
			QD.site("R10", 2, "Defeat the third by the Eaten Sea."),
			QD.talk(QD.realm_npc("R10", "Sister Lumen"), "the three keys", "The way to the heart is open. Dawn go with you.", "Return to Sister Lumen.")],
			QD.reward(4000)),
		_r("R-UE02", "Sister Lumen's Candle", "R10", "Sister Lumen", 66, "the last candle",
			"My candle shrinks. Bring me light from the living world.",
			[QD.collect("res://data/ingredients/fire_salts.tres", 3, "Bring three fire salts, light from the living world."),
			QD.talk(QD.realm_npc("R10", "Sister Lumen"), "the light", "It burns bright! Learn the Dawn's fire from me.", "Bring the light to Sister Lumen.")],
			QD.reward(500, {"spell": "incinerate"})),
		_r("R-DK01", "The Promise Market", "R11", "The Promise-Keeper", 30, "the promise market",
			"Here we pay in promises. Buy the Treasury key... and keep your word.",
			[QD.site("R11", 0, "Pay your promise: clear the Coral Cathedral's guards."),
			QD.talk(QD.realm_npc("R11", "The Promise-Keeper"), "my promise is kept", "Kept! The key is yours, and the Market's trust.", "Return to the Promise-Keeper.")],
			QD.reward(1200)),
		_r("R-DK02", "The Kraken's Garden", "R11", "Drowned Merchant Ilse", 42, "the kraken",
			"The kraken's heart is the Drowned King's power. Kill it.",
			[QD.site("R11", 2, "Kill the kraken in its garden of drowned ships."),
			QD.talk(QD.realm_npc("R11", "Drowned Merchant Ilse"), "the kraken is dead", "The King weakens forever! Take this, from the drowned.", "Return to Ilse.")],
			QD.reward(2500, {"named": [QD.named("Kraken-Tooth Trident", W + "ebon_spear.tres", [["frost_damage", 14], ["absorb_health", 5]])]})),
		_r("R-VR01", "The Unburied", "R12", "Brother Silent", 42, "the unburied crew",
			"(He writes:) A wrecked crew cannot pass. Their bodies were never buried.",
			[QD.site("R12", 1, "Recover the crew's tokens from the Shipwreck of the Unburied."),
			QD.talk(QD.lord("Heron's Wick"), "burial tokens", "We'll bury them proper, in the old churchyard.", "Bury the tokens on the mainland, at Heron's Wick."),
			QD.talk(QD.realm_npc("R12", "Brother Silent"), "they are buried", "(He writes:) They have gone. Thank you.", "Return to Brother Silent.")],
			QD.reward(1000)),
		_r("R-VR02", "The Weighing of the Prince", "R12", "The Ghost of Prince Caedric", 48, "your last night",
			"You found me. Sit. I'll tell you how I died, and what I want my daughter to know.",
			[QD.site("R12", 2, "Walk with the prince to the Ferryman's Cave, where his memory waits."),
			QD.talk(QD.cast("Princess Elowen Aurelane", "Kingsreach"), "your father's words", "He said that? ...Thank you. I won't forget.", "Carry his last words to Elowen in Kingsreach.")],
			QD.reward(500, {"title": "Keeper of the Prince's Words"}), QD.req(["S-KR05"])),
		_r("R-VR03", "The Lighthouse of Last Sight", "R12", "Brother Silent", 45, "the dark lighthouse",
			"(He writes:) Relight the lighthouse and the restless of your land will fade.",
			[QD.site("R12", 0, "Clear the Lighthouse of Last Sight."),
			QD.talk(QD.realm_npc("R12", "Brother Silent"), "the light is lit", "(He writes:) The dead see the way. Fewer will wander now.", "Return to Brother Silent.")],
			QD.reward(1200)),
	]
