const I := "res://data/ingredients/"


static func _w(id: String, name: String, level: int, place: Dictionary, who: String, body: String, hook: String, intro: String, steps: Array, reward: Dictionary) -> Dictionary:
	return QD.q(id, name, "The Wilds", QD.spawn(place, who, body), level, hook, intro, steps, reward)


