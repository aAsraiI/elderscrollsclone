class_name QuestDefsGuilds
extends RefCounted
## The questlines of the eight guilds (G-..), given by each guild's leader on top of their radiant
## jobs. 03 is the mid gate (needed for rank 3), 06 the final gate (rank 5), 07 makes you its head.

const W := "res://data/weapons/"
const A := "res://data/armor/"
const J := "res://data/jewelry/"
const R := "res://data/ranged/"
const RANKS := [1, 1, 2, 3, 3, 4, 5, 5]


static func _g(f: String, code: String, n: int, name: String, level: int, hook: String, intro: String, steps: Array, reward: Dictionary, after: Array = []) -> Dictionary:
	var prev: Array = [] if n == 1 else ["G-%s%02d" % [code, n - 1]]
	prev.append_array(after)
	return QD.q("G-%s%02d" % [code, n], name, Factions.display_name(f), QD.guild(f), level, hook, intro, steps, reward, QD.fac(f, RANKS[n - 1], prev))


