[gd_resource type="Resource" script_class="ItemData" format=3]

[ext_resource type="Script" path="res://scripts/items/item_data.gd" id="1_item"]

[resource]
script = ExtResource("1_item")
id = &"falconers_glove"
display_name = "Falconer's Glove"
description = "A thick leather glove and a hawk that answers it. Use it (E in the inventory) outdoors with Hunting 50: the hawk shows you what lives around you and often brings back small game. Once an hour."
item_type = 9
weight = 0.5
value = 400
min_level = 15
loot_tags = PackedStringArray("hunter", "shop")
