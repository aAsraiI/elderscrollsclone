things = PackedStringArray("the White Stag", "Old Gnasher", "the Ashen Wolf", "Greyback", "the Marsh Hag", "Ironhide")
enemies = PackedStringArray("frost_bear", "forest=forest_troll", "desert=sand_scorpion", "swamp=bog_lurker", "highlands=cave_troll")
count_min = 1
count_max = 1
days = 14
